#!/usr/bin/env bash
set -e
if [[ ! -d "/home/drz/Documents/semesterV/etl/Activities/1ab/1b" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/drz/Documents/semesterV/etl/Activities/1ab/1b")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/drz/Documents/semesterV/etl/Activities/1ab/1b" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/home/drz/Documents/semesterV/etl/Activities/1ab/1b/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/home/drz/Documents/semesterV/etl/Activities/1ab/1b/.envrc" "/home/drz/Documents/semesterV/etl/Activities/1ab/1b/.direnv"/*.rc
